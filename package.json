{
  "name": "ahmed-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check README.md PRE-DEPLOY-CHECKLIST.md package.json next.config.ts src/app/api/contact/route.ts src/lib/env.ts src/components/sections/about.tsx src/components/sections/hero.tsx src/components/layout/footer.tsx src/data/site.ts",
    "check": "npm run lint && npm run typecheck && npm run build",
    "predeploy": "npm run check",
    "analyze": "cross-env ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
